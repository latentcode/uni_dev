{
  "name": "University Programming",
  "dockerComposeFile": "../../compose.yaml",
  "service": "programming",
  "workspaceFolder": "/workspace/classes",
  "remoteUser": "student",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "openai.chatgpt"
      ]
    }
  }
}
