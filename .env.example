# Docker bind mounts. These directories are user-owned and ignored by the
# uni_dev repository. Relative paths are resolved from this repository root;
# absolute macOS paths, including /Volumes/... paths, are also supported.
HOST_WEB_ROOT=./personal/web
HOST_PROGRAMMING_ROOT=./classes

# Browser and application ports exposed only on localhost.
WEB_HOST_PORT=8080
PROGRAMMING_HOST_PORT=8000
PROGRAMMING_CONTAINER_PORT=8000

# Apache's document root inside the web container. Keep this absolute.
WEB_CONTAINER_WEB_ROOT=/var/www/html

# The bootstrap script replaces these with the current macOS user IDs.
DEV_UID=1000
DEV_GID=1000

# Optional, explicit opt-in credentials for the containers. The DEV_ prefix
# prevents an unrelated exported host token from being injected by Compose.
# Never commit .env. Prefer interactive GitHub and Codex authentication.
DEV_GH_TOKEN=
DEV_OPENAI_API_KEY=
